# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# API auth — set a strong random string in production; leave empty to disable locally.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
# 'production' refuses to serve data when API_SECRET_KEY is empty. Local dev can leave it unset.
# APP_ENV=development
# Calls per UTC day to endpoints that spend Anthropic money (0 turns them off).
# AI_DAILY_LIMIT=100

# Model tiers (optional — defaults shown below)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001      # classification, simple tasks
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5    # complex analysis, drafting

# Ticket tools (optional). Use a SANDBOX workspace for development.
LINEAR_API_KEY=lin_api_xxxxx

# Where briefings and sync cursors are stored (optional)
# BRIEFING_DB_PATH=./briefing_data/briefings.db

# ChromaDB (optional, defaults to local)
CHROMA_PERSIST_DIR=./chroma_data

# Log level
LOG_LEVEL=INFO

# Fly watcher scope (start.sh). The watcher does not start without WATCH_LABEL.
# WATCH_LABEL=support-buddy
# WATCH_TEAM=SUP     # optional
